{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poker Trainer auditable solver strategy pack v1",
  "type": "object",
  "required": ["format", "name", "version", "source", "solution", "nodes", "integrity", "audit"],
  "properties": {
    "format": {"const": "poker-trainer-strategy-pack/v1"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["url", "solver"], "properties": {"url": {"type": "string", "format": "uri"}, "solver": {"type": "string"}, "exportedAt": {"type": "string"}}},
    "solution": {"type": "object", "required": ["game", "players", "stackBB", "bettingTree"], "properties": {"game": {"const": "NLHE"}, "players": {"type": "integer", "minimum": 2}, "stackBB": {"type": "number", "exclusiveMinimum": 0}, "bettingTree": {"type": "string", "minLength": 1}}},
    "integrity": {"type": "object", "required": ["algorithm", "payloadSha256"], "properties": {"algorithm": {"const": "sha256"}, "payloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "audit": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["unverified", "solver-verified"]}, "verifiedAt": {"type": "string"}, "reviewer": {"type": "string"}}},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "match", "strategy"], "properties": {"id": {"type": "string"}, "match": {"type": "object", "required": ["street", "heroPosition", "villainPosition"], "properties": {"street": {"enum": ["preflop", "flop", "turn", "river"]}, "heroPosition": {"type": "string"}, "villainPosition": {"type": "string"}}}, "strategy": {"type": "object", "required": ["frequencies"], "properties": {"frequencies": {"type": "object", "minProperties": 1}, "evBB": {"type": "object"}}}}}}
  }
}
